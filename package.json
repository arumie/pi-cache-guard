{
  "name": "@arumie/pi-cache-guard",
  "version": "1.0.0",
  "description": "A pi extension that stops expensive runs after significant prompt-cache misses",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "prompt-cache",
    "cache-guard",
    "coding-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arumie/pi-cache-guard.git"
  },
  "bugs": {
    "url": "https://github.com/arumie/pi-cache-guard/issues"
  },
  "homepage": "https://github.com/arumie/pi-cache-guard#readme",
  "files": [
    "extensions/cache-guard/index.ts",
    "extensions/cache-guard/README.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --experimental-strip-types test/package-manifest.test.ts",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run",
    "release:check": "npm test && npm run typecheck && npm run pack:check"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "pi": {
    "extensions": [
      "./extensions/cache-guard/index.ts"
    ]
  }
}
